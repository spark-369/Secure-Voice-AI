# ============================================================
# SecureVoice AI — LOCAL DEVELOPMENT configuration (single source)
#
# - app/core/config.py loads this file when the app runs from
#   backend/ (uvicorn / celery / pytest)
# - docker-compose.yml reads the Postgres credentials below for
#   the local database container
# ============================================================

# --- PostgreSQL credentials (shared with docker-compose.yml;
# --- mirrored in DATABASE_URL below — keep both in sync)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=securevoice

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Application database URL ----------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:mysecretpassword@localhost:5432/securevoice

# --- Redis: cache/rate-limiting + Celery broker ----------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication (JWT) --------------------------------------
# Generate a strong secret for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-only-8f14e45fceea167a5a36dedd4bea25485c1f36de
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI models --------------------------------------------------
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
CLASSIFIER_MODEL_NAME=facebook/bart-large-mnli
# Warm models at API startup instead of on first request:
PRELOAD_MODELS=false

# --- Optional zero-infra smoke-test mode ------------------------
# Comment out the DATABASE_URL above and uncomment this line to
# develop without Postgres (chat/LLM/RAG still work; alerts and
# caching need Redis + a running Celery worker):
# DATABASE_URL=sqlite:///./securevoice-dev.db
